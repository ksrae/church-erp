rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // 자료실 파일 - 5MB 제한 (churches/{id}/resources/** 보다 먼저 매칭되도록 우선 선언)
    match /churches/{churchId}/resources/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && (request.resource == null || request.resource.size < 5 * 1024 * 1024);
    }

    // 교회 브랜딩 자산 (로고, 사진) - 공개 읽기, 인증된 사용자만 쓰기
    match /churches/{churchId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 기타 자산 - 인증 필요
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
