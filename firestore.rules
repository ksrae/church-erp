rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 슈퍼유저 설정 - 공개 읽기 (로그인 판별용), 인증된 사용자만 쓰기
    match /config/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 교회 목록 - 공개 읽기 (포탈에서 교회 목록 표시)
    match /churches/{churchId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 교회 관리자 - 인증 필요
    match /churchAdmins/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // 포탈 게시물 (슈퍼유저 작성) - 게시된 것은 공개
    match /portalPosts/{postId} {
      allow read: if resource.data.isPublished == true || request.auth != null;
      allow write: if request.auth != null;
    }

    // 포탈 Hero 배너 (슈퍼유저 작성) - 활성화된 것은 공개
    match /portalHeroes/{heroId} {
      allow read: if resource.data.isActive == true || request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // 예배 인스턴스 - 공개된 것은 포탈에서 읽기 가능
    match /worshipInstances/{doc} {
      allow read: if resource.data.isPublished == true || request.auth != null;
      allow write: if request.auth != null;
    }

    // 공지사항 - 게시된 것은 공개
    match /announcements/{doc} {
      allow read: if resource.data.status == 'published' || request.auth != null;
      allow write: if request.auth != null;
    }

    // 교회별 데이터 (churchData/{churchId}/*)
    match /churchData/{churchId}/{collection}/{doc} {
      allow read, write: if request.auth != null;
    }

    // 활동 로그
    match /activityLogs/{doc} {
      allow read, write: if request.auth != null;
    }

    // 예배 스케줄
    match /worshipSchedules/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 뉴스 RSS 피드 소스 (슈퍼유저 관리) - 활성화된 것은 공개 읽기
    match /newsSources/{doc} {
      allow read: if resource.data.enabled == true || request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
