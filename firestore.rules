rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 슈퍼유저 설정 - 공개 읽기 (로그인 판별용), 인증된 사용자만 쓰기
    match /config/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 슈퍼유저 대리 명단 — 주 슈퍼유저만 추가/삭제 가능
    match /superDelegates/{doc} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email == get(/databases/$(database)/documents/config/superUser).data.email;
    }

    // 교회 목록 - 공개 읽기 (포탈에서 교회 목록/브랜딩 표시)
    match /churches/{churchId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 교회 관리자 - 인증 필요
    match /churchAdmins/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // 예배/일정 인스턴스 - 공개된 것은 포탈에서 읽기 가능
    match /worshipInstances/{doc} {
      allow read: if resource.data.isPublished == true || request.auth != null;
      allow write: if request.auth != null;
    }

    // 공지사항 - 게시된 것은 공개
    match /announcements/{doc} {
      allow read: if resource.data.status == 'published' || request.auth != null;
      allow write: if request.auth != null;
    }

    // 자료실 - 공개(public)는 포탈에서 읽기 가능, 비공개는 관리자만
    match /resources/{doc} {
      allow read: if resource.data.visibility == 'public' || request.auth != null;
      allow write: if request.auth != null;
    }

    // 교회별 데이터 (churchData/{churchId}/*)
    match /churchData/{churchId}/{collection}/{doc} {
      allow read, write: if request.auth != null;
    }

    // 활동 로그
    match /activityLogs/{doc} {
      allow read, write: if request.auth != null;
    }

    // 예배 스케줄 (반복 예배 정의)
    match /worshipSchedules/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 교회 정보 수정 요청 — 인증된 교회 관리자가 작성, 슈퍼유저가 처리
    match /churchChangeRequests/{doc} {
      allow read, write: if request.auth != null;
    }

    // 상태 문의 요청 — 보류/정지 관리자가 작성하거나 포탈 방문자가 일반 문의로 작성
    match /churchStatusRequests/{doc} {
      allow read: if request.auth != null;
      allow create: if
        request.resource.data.subject is string && request.resource.data.subject.size() > 0 &&
        request.resource.data.message is string && request.resource.data.message.size() > 0 &&
        request.resource.data.context is string &&
        request.resource.data.status == "pending";
      allow update, delete: if request.auth != null;
    }
  }
}
